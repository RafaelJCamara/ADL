{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Node ESM straight out of tsc — no bundler, ever (C-10).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    // verbatimModuleSyntax keeps `import type` honest, which matters under
    // nodenext where an elided import changes runtime behaviour.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
