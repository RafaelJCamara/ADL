{
  "name": "@adl/plugin-sdk",
  "version": "0.0.0",
  "type": "module",
  "description": "The published contract a third-party ADL harness depends on — verdicts, findings, criterion identity, StageError, and the Stage interface. Re-exports @adl/core; defines nothing of its own.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretypecheck": "tsc -b ../core",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -b ../core",
    "test": "vitest run"
  },
  "dependencies": {
    "@adl/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
