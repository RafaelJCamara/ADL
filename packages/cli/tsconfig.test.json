// WR-03: the program `test/**/*.ts` is checked under.
//
// `tsconfig.json` deliberately includes only `src/**/*.ts`: it is the build
// program, it emits to `dist/`, and pulling `test/` into it would ship the
// suite (and a `vitest` type dependency) to consumers. But `vitest` only
// strips types — it does not typecheck — so a test-only object literal
// whose shape has drifted from the real interface can pass every runtime
// assertion it wrote itself while silently no longer matching the type it
// claims to satisfy. This program is what makes `pnpm --filter @adl/cli
// typecheck` actually compile `test/`, mirroring
// `packages/db/tsconfig.test.json`'s rationale: an assertion that is never
// compiled asserts nothing.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // The build program's `rootDir` is `src`, but `test/**/*.ts` is a
    // sibling of `src/`, not a descendant of it — widen to the package root
    // for this non-emitting program only, matching `@adl/db`'s own
    // `tsconfig.test.json` (whose build program is already rooted at ".").
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
