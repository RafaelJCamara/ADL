{
  "name": "@adl/cli",
  "version": "0.0.0",
  "type": "module",
  "description": "ADL CLI — status, logs, pause, kill. Talks to the manager over HTTP only (D-18, D-21); structurally cannot resolve @adl/db or @adl/manager.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "adl": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
