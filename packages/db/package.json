{
  "name": "@adl/db",
  "version": "0.0.0",
  "type": "module",
  "description": "ADL persistence — schema, hand-written migrations, and the migration runner. The only package that touches better-sqlite3.",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": ["dist", "migrations"],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -b ../core",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "kysely": "0.29.5",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@adl/core": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
