{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Unlike `@adl/db`, there is no `migrations/` sibling to hoist, so `rootDir`
    // is `src` and `dist` mirrors it directly.
    "rootDir": "src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // Required, not incidental: this package forks and supervises the worker
    // process (`child_process.fork`) and runs the HTTP server, so it uses
    // `node:child_process`, `node:process`, and friends.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
