{
  "name": "adl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ADL — Autonomous Delivery Loop. A feature folder goes in, a green human-approvable PR comes out.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && vitest run --project root",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
